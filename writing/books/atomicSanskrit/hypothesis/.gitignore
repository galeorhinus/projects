# API tokens and passwords are secrets -- never committed.
token.txt
anthropic_token.txt
smtp_app_password.txt

# Pulled annotation content is readers' private/candid feedback -- never
# committed, same privacy posture as server/'s invite_status.json.
data/*.json
data/*.sqlite3

# Digest-email state (last-seen annotation IDs) -- runtime state, not source.
digest_state.json

# Cron output on amrut -- runtime log, not source.
cron.log

# HTML preview written by digest_send.py --dry-run -- embeds candid
# annotation content, same privacy posture as dashboard.html.
digest_preview.html

# Generated dashboard embeds the same candid annotation content -- same
# privacy posture as data/*.json, never committed. Published only as a
# private Claude Artifact for personal triage.
dashboard.html

# resolve_check.py / post_replies.py runtime state and output -- same
# privacy posture as data/*.json (candid annotation content), plus
# replied_state.json specifically must never be committed even if it
# were just IDs, since losing track of it risks double-posting replies.
data/resolve_report.json
data/draft_replies.md
replied_state.json
