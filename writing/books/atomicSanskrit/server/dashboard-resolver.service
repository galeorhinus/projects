[Unit]
Description=Reader Margins dashboard — per-reader resolver
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/secondshanti/dashboard_resolver.py
Restart=on-failure
RestartSec=5
User=www-data
Group=www-data

# Loopback-only (127.0.0.1:8091), reached only through Caddy's reverse_proxy
# for /as/private/dashboard/* -- same oauth2-proxy gate as the rest of
# /as/private/*. Runs as www-data (not ubuntu, unlike build_dashboard.py's
# cron job) specifically so it can read /etc/secondshanti/invite_roster.json
# and invite_status.json, both 640 www-data:www-data -- same reasoning as
# server/secondshanti-request-access.service.
#
# Almost read-only. This service resolves an email to a slug and serves a
# pre-built page; the ONE thing it writes is the reader "Update now"
# trigger file, which is why ProtectSystem=strict now carries a single
# narrow ReadWritePaths exception rather than none at all.
#
# Scoped to the directory, not the whole tree: the actual refresh runs in
# dashboard-refresh.service as ubuntu, and this service is never given the
# Hypothesis API token or write access to anything else. Without this line
# the touch fails with EROFS and the button returns HTTP 500 -- observed
# on first deploy 2026-08-28.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/secondshanti

[Install]
WantedBy=multi-user.target
