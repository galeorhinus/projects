% Non-Latin script + symbol font handling for xelatex.
% TEMPLATE FILE — processed by build_book.py at build time.
% The token __DEVANAGARIFONT__ is replaced with the value of `devanagarifont`
% from as_book.yaml; the rendered file is written to build/devanagari-preamble.tex
% and included via pandoc's --include-in-header flag.
%
% Strategy: explicit per-run font wrapping (no ucharclasses).
%   - mainfont (set via as_book.yaml) handles Latin + IAST diacritics.
%   - build_book.py's assemble step scans for runs of each script's Unicode
%     range and wraps them in raw-LaTeX `{\fontname …}` so the font switch
%     is unconditional inside the wrap group and reverts cleanly at the
%     closing brace.
%   - Each script declared here covers one Unicode block (or related blocks);
%     the build-script wrapper lists the exact range per script.
%   - ucharclasses was tried earlier and removed (it routes some punctuation
%     codepoints through a separate class that overrides the wrap-group's
%     font selection).

\usepackage{fontspec}
\usepackage{caption}
\usepackage[normalem]{ulem}

% A book-class chapter starts on a recto page. Keep any intervening verso
% genuinely blank instead of carrying the preceding chapter's running header.
\makeatletter
\renewcommand{\cleardoublepage}{%
  \clearpage
  \if@twoside
    \ifodd\c@page\else
      \hbox{}\thispagestyle{empty}\newpage
      \if@twocolumn\hbox{}\newpage\fi
    \fi
  \fi}
\makeatother

% Pandoc normally calls \mainmatter before the assembled manuscript begins.
% The Preface and Prologue belong to the front matter, so defer that switch
% until the explicit marker immediately before Chapter 0.
% Standalone `convert` builds use an article class, which has no \mainmatter;
% define a no-op there so the shared preamble remains valid in both classes.
\providecommand{\mainmatter}{}
\let\bookmainmatter\mainmatter
\renewcommand{\mainmatter}{}

% Chapter-opening folio. book-class chapter, part and contents openers all
% call \thispagestyle{plain}, which prints the page number bottom-centre
% while the running head is suppressed. Aliasing plain to empty removes it
% from every one of those openers. Substituted by build_book.py from
% LAYOUT_CHAPTER_FOLIO (and --chapter-folio / --no-chapter-folio); the
% token expands to nothing when the folio is wanted.
__CHAPTER_OPENING_FOLIO__

% Scale figures uniformly, never to fit a box.
%
% Pandoc emits keepaspectratio for an image that sets only a width, but
% DROPS it as soon as the markdown also gives an explicit height:
%
%   {width=100%}             -> [width=1\linewidth,height=\textheight,keepaspectratio]
%   {width=100% height=80%}  -> [width=1\linewidth,height=0.8\textheight]
%
% so the eight figures in Appendix Parts 3 and 4 that cap their height were
% being stretched to exactly that box — visibly distorted (Figure A.3.3).
% Setting the key globally restores uniform scaling while keeping the height
% cap doing its real job, which is bounding the figure rather than reshaping
% it: \includegraphics then fits the image inside both limits and stops at
% whichever binds first.
\setkeys{Gin}{keepaspectratio}

% Figure numbers are authored directly in Markdown captions (for example,
% Figure 0.1 and Figure E.3). Suppress LaTeX's independent sequential label so
% numbered and intentionally unnumbered captions both render as written.
\captionsetup[figure]{labelformat=empty}

% Keep ordinary figures beside the surrounding prose whenever space permits.
% Reserve float-only pages for figures that occupy most of the text area.
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.1}
\renewcommand{\floatpagefraction}{0.85}

\newfontfamily{\devanagarifont}[Script=Devanagari__DEVANAGARIFONTOPTS__]{__DEVANAGARIFONT__}
% The configured Devanagari face may not cover the Vedic Extensions block.
% Declare it separately so ordinary Devanagari typography stays intact.
\newfontfamily{\vedicfont}[Script=Devanagari]{Tiro Devanagari Sanskrit}
% Sindhi implosive letters (U+097B–U+097F: ॻ ॼ ॽ ॾ ॿ). Tiro Devanagari
% Sanskrit is a Sanskrit face and has no glyphs for them, so under Tiro they
% rendered as "Missing character" and vanished from the page — silently
% deleting the evidence in the sindhi-implosives-inventory endnote, whose
% whole point is that these consonants exist in the subcontinent and are
% absent from the varṇamālā. Adobe Devanagari covers them and is installed on
% both the authoring machine and the build host.
\newfontfamily{\sindhifont}[Script=Devanagari]{Adobe Devanagari}
% The scripts below each carry real comparative-linguistics content in the
% manuscript (verified 2026-08-10 by grepping the assembled build for each
% script's Unicode range) — not decorative, do not remove without re-checking
% build/atomic_sanskrit.md. Kannada and Malayalam were declared here too but
% had zero occurrences and were removed 2026-08-10. Fonts are Noto Sans
% (Google, OFL-licensed, available via apt on every Linux build host) in
% place of the prior macOS-only system fonts (Geeza Pro, Arial Hebrew, the
% Apple "Sangam MN" family, Hiragino Sans, PingFang SC).
\newfontfamily{\arabicfont}[Script=Arabic]{Noto Sans Arabic}
\newfontfamily{\hebrewfont}[Script=Hebrew]{Noto Sans Hebrew}
\newfontfamily{\tamilfont}[Script=Tamil]{Noto Sans Tamil}
\newfontfamily{\telugufont}[Script=Telugu]{Noto Sans Telugu}
\newfontfamily{\jpfont}{Noto Sans CJK JP}
\newfontfamily{\cjkfont}{Noto Sans CJK SC}
\newfontfamily{\oldpersianfont}{Noto Sans Old Persian}
\newfontfamily{\gothicfont}{Noto Sans Gothic}
\newfontfamily{\avestanfont}{Noto Sans Avestan}
% Brāhmī (U+11000–U+1107F). Added 2026-08-22: the Prakrit forms quoted from
% the pyramid's own descent chain in the gaya-gavi endnote are written in
% Brāhmī, and without this they fell through to the Latin main font and vanished from
% the PDF as "Missing character" warnings rather than an error.
\newfontfamily{\brahmifont}{Noto Sans Brahmi}
% Symbol / Latin-Extended fallback for arrows, subscripts, modifier letters,
% and the small set of characters STIX Two Text lacks (⟪, ⟫, ǵ, ǎ,
% polytonic Greek forms, ↔, ∞, etc.).
% DejaVu Sans chosen for breadth of Unicode coverage, an OFL license, and
% availability on every platform this book is built on (Arial Unicode MS,
% the prior choice, is Windows/macOS-only and absent on Linux build hosts).
% Verified 2026-08-10: covers all the characters above via a direct XeLaTeX
% compile. STIX Two Text, the current body face, still needs this fallback
% for arrows, atomic brackets, and a small set of historical forms. Noto Sans (the
% un-suffixed family) was tried but not all macOS systems ship it — only
% script-specific variants like "Noto Sans Devanagari" are present there.)
\newfontfamily{\symbolfont}{DejaVu Sans}

% --- Sanskrit chapter-opening epigraph typography ---
%
% Deploy inside a markdown blockquote, on its own line after the Devanagari
% verse and the IAST gloss. The macro right-aligns the attribution with an
% em-dash prefix and italicizes the source name. Pair with a \bigskip raw-LaTeX
% block after the blockquote for vertical separation from the chapter body.
%
% Markdown form:
%   > ऋटुरषाणां मूर्धा ।
%   >
%   > *ṛṭuraṣāṇāṃ mūrdhā.*
%   >
%   > \episource{Pāṇinīya Śikṣā tradition}
%
%   \bigskip
%
% Resulting LaTeX: \hfill{\itshape\textemdash\ Pāṇinīya Śikṣā tradition}
\newcommand{\episource}[1]{\hfill{\itshape\textemdash\ #1}}

% Epigraph environment. Pairs with the markdown fenced-div wrapper
% `::: epigraph ... :::` that wraps the verse + IAST + \episource{} lines.
% Applies a slightly larger font size for prominence; leaves \episource{}
% (right-aligned italic em-dash + source) and the IAST *...* markdown
% italics to handle their own typographic work.
\newenvironment{epigraph}{\par\medskip\bgroup\large}{\egroup\par\medskip}

% --- \partopener: part title + opener prose on the same page ---
%
% Modified \part that allows the part opener prose (the framing paragraph
% under the part title) to flow on the part-title page rather than being
% pushed to the next page by \cleardoublepage.
%
% Standard book-class \part centers the title vertically on a near-empty
% page and forces \cleardoublepage afterward, so opener prose lands on
% the page following the title page. \partopener instead:
%   - Forces a new page (the part still starts on a new recto)
%   - Places the title near the top of the page (top vskip), not centered
%   - Suppresses the trailing \cleardoublepage so subsequent document
%     content (the opener prose) flows on the same page
%
% Usage:
%   \partopener[TOC TEXT]{PAGE TITLE}
%   <opener prose flows as ordinary document content here>
%
% If TOC TEXT is omitted, PAGE TITLE is used for the TOC entry.
\makeatletter
\newcommand{\partopener}[2][]{%
  \if@openright\cleardoublepage\else\clearpage\fi
  \thispagestyle{plain}%
  \refstepcounter{part}%
  \def\partopener@toc{#1}%
  \ifx\partopener@toc\@empty
    \addcontentsline{toc}{part}{#2}%
  \else
    \addcontentsline{toc}{part}{#1}%
  \fi
  \markboth{}{}%
  \vspace*{4em}% top margin before the title
  {\centering
   \interlinepenalty\@M
   \normalfont
   \Huge\bfseries #2\par}%
  \vskip 3em\relax
  % document flow continues here — opener prose appears on this page
}
\makeatother

% Pre-warm each font at document start so the first wrap-group transition
% does not leave its first glyph in the outgoing font.
\AtBeginDocument{%
  \setbox0=\hbox{\devanagarifont क}%
  \setbox0=\hbox{\vedicfont क}%
  \setbox0=\hbox{\sindhifont ॿ}%
  \setbox0=\hbox{\arabicfont ا}%
  \setbox0=\hbox{\hebrewfont א}%
  \setbox0=\hbox{\tamilfont அ}%
  \setbox0=\hbox{\telugufont అ}%
  \setbox0=\hbox{\jpfont ア}%
  \setbox0=\hbox{\cjkfont 中}%
  \setbox0=\hbox{\oldpersianfont 𐎠}%
  \setbox0=\hbox{\gothicfont 𐌰}%
  \setbox0=\hbox{\avestanfont 𐬀}%
  \setbox0=\hbox{\symbolfont →}%
}
