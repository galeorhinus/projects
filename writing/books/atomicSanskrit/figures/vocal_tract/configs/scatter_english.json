{
  "name": "scatter_english",
  "description": "English consonants as a scatter overlay on the vocal tract. 7 columns (glottal, velar, palatal/post-alveolar, alveolar, dental, labio-dental, bilabial) ordered back→front — an IPA-compact frame designed to be reused for cross-language comparison. 10 rows × 0.1in delta_r centered at r=2.5. ~24 cells filled.",
  "geometry": { "r1": 2.5, "r2": 2.5, "w": 0.35 },
  "canvas": { "width": 4.5, "height": 3.0 },
  "base_ribbon": {
    "t1": 135,
    "t2": 225,
    "stroke_color": "#bbbbbb",
    "stroke_size": 0.01,
    "fill_color": "none",
    "opacity": 0.7
  },
  "scatter": {
    "mode": "grid",
    "angular_range": { "center": 180, "half_width_deg": 45 },
    "rows": { "r_center": 2.5, "delta_r": 0.1 },
    "jitter": { "theta_deg": 3.0, "r": 0.04, "seed": 41 },
    "circle_radius": 0.06,
    "fill_color": "#666666",
    "opacity": 0.5,
    "matrix": [
      ["",  "k", "",   "t", "",  "",  "p"],
      ["",  "g", "",   "d", "",  "",  "b"],
      ["",  "",  "tʃ", "",  "",  "",  ""],
      ["",  "",  "dʒ", "",  "",  "",  ""],
      ["h", "",  "ʃ",  "s", "θ", "f", ""],
      ["",  "",  "ʒ",  "z", "ð", "v", ""],
      ["",  "ŋ", "",   "n", "",  "",  "m"],
      ["",  "",  "",   "l", "",  "",  ""],
      ["",  "",  "",   "r", "",  "",  ""],
      ["",  "",  "j",  "",  "",  "",  "w"]
    ]
  }
}
