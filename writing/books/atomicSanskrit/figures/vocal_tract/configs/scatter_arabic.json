  "canvas": { "width": 4.5, "height": 3.0 },
  "base_ribbon": {
    "t1": 135,
    "t2": 225,
    "stroke_color": "#bbbbbb",
    "stroke_size": 0.01,
    "fill_color": "none",
    "opacity": 0.7
  },
