{
  "name": "scatter_french",
  "description": "French consonants as a scatter overlay on the vocal tract. Same 7-column IPA-compact frame as scatter_english.json for cross-language comparison: glottal, velar, palatal/post-alveolar, alveolar, dental, labio-dental, bilabial (back→front). 10 rows × 0.1in delta_r centered at r=2.5. ~20 cells. French's signature uvular ʁ sits in the velar column.",
  "geometry": { "r1": 2.5, "r2": 2.5, "w": 0.35 },
  "canvas": { "width": 4.5, "height": 3.0 },
  "base_ribbon": {
    "t1": 135,
    "t2": 225,
    "stroke_color": "#bbbbbb",
    "stroke_size": 0.01,
    "fill_color": "none",
    "opacity": 0.7
  },
  "scatter": {
    "mode": "grid",
    "angular_range": { "center": 180, "half_width_deg": 45 },
    "rows": { "r_center": 2.5, "delta_r": 0.1 },
    "jitter": { "theta_deg": 3.0, "r": 0.04, "seed": 53 },
    "circle_radius": 0.06,
    "fill_color": "#666666",
    "opacity": 0.5,
    "matrix": [
      ["",  "k",  "",   "t", "",  "",  "p"],
      ["",  "g",  "",   "d", "",  "",  "b"],
      ["",  "",   "",   "",  "",  "",  ""],
      ["",  "",   "",   "",  "",  "",  ""],
      ["",  "",   "ʃ",  "s", "",  "f", ""],
      ["",  "ʁ",  "ʒ",  "z", "",  "v", ""],
      ["",  "ŋ",  "ɲ",  "n", "",  "",  "m"],
      ["",  "",   "",   "l", "",  "",  ""],
      ["",  "",   "",   "",  "",  "",  ""],
      ["",  "",   "j",  "",  "",  "",  "w"]
    ]
  }
}
