{
  "name": "scatter_korean",
  "description": "Korean consonants as a scatter overlay on the vocal tract. 6 columns (glottal, velar, palatal, post-alveolar, alveolar, bilabial) ordered back→front per Hunminjeongeum classification. 11 rows × 0.1in delta_r centered at r=2.5. 19 cells filled out of 66 (from AP3 audiography source).",
  "geometry": { "r1": 2.5, "r2": 2.5, "w": 0.35 },
  "canvas": { "width": 4.5, "height": 3.0 },
  "base_ribbon": {
    "t1": 135,
    "t2": 225,
    "stroke_color": "#bbbbbb",
    "stroke_size": 0.01,
    "fill_color": "none",
    "opacity": 0.7
  },
  "scatter": {
    "mode": "grid",
    "angular_range": { "center": 180, "half_width_deg": 45 },
    "rows": { "r_center": 2.5, "delta_r": 0.1 },
    "jitter": { "theta_deg": 3.0, "r": 0.04, "seed": 31 },
    "circle_radius": 0.06,
    "fill_color": "#666666",
    "opacity": 0.5,
    "matrix": [
      ["",  "ㄱ", "",  "",   "ㄷ", "ㅂ"],
      ["",  "ㅋ", "",  "",   "ㅌ", "ㅍ"],
      ["",  "ㄲ", "",  "",   "ㄸ", "ㅃ"],
      ["",  "",   "",  "ㅈ", "",   ""  ],
      ["",  "",   "",  "ㅊ", "",   ""  ],
      ["",  "",   "",  "ㅉ", "",   ""  ],
      ["",  "ㅇ", "",  "",   "ㄴ", "ㅁ"],
      ["",  "",   "",  "",   "ㄹ", ""  ],
      ["",  "",   "y", "",   "",   "w" ],
      ["ㅎ","",   "",  "",   "ㅅ", ""  ],
      ["",  "",   "",  "",   "ㅆ", ""  ]
    ]
  }
}
